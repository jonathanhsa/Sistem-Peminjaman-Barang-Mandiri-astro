---
import '../../styles/global.css';
import { getCurrentUser } from '../../lib/auth';
import { db, schema } from '../../db';
import { eq, and, desc } from 'drizzle-orm';
import { Mascot } from '../illustrations/Mascot';
import { ClientRouter } from 'astro:transitions';
import { formatRupiah } from '../../lib/format-rupiah';
import { calculateFine } from '../../lib/fine';

interface Props {
  title?: string;
  activeNav?: 'dashboard' | 'katalog' | 'pinjam' | 'riwayat' | 'notifikasi';
}

const { title = 'Sistem Peminjaman Mandiri Kampus', activeNav = 'katalog' } = Astro.props;

const user = await getCurrentUser(Astro.cookies);
if (!user) {
  return Astro.redirect('/login');
}
if (user.role === 'admin') {
  return Astro.redirect('/admin/dashboard');
}

// Get unread notification count
const unreadNotifs = await db
  .select()
  .from(schema.notifications)
  .where(and(eq(schema.notifications.userId, user.id), eq(schema.notifications.isRead, false)))
  .all();
const unreadCount = unreadNotifs.length;

// Fetch user borrowings for Profile Beranda Dropdown
const userBorrowings = await db
  .select({
    borrowing: schema.borrowings,
    item: schema.items,
  })
  .from(schema.borrowings)
  .innerJoin(schema.items, eq(schema.borrowings.itemId, schema.items.id))
  .where(eq(schema.borrowings.userId, user.id))
  .orderBy(desc(schema.borrowings.createdAt))
  .all();

let activeCount = 0;
let pendingCount = 0;
let returnedCount = 0;
let totalFineUnpaid = 0;

const processedBorrowings = userBorrowings.map(({ borrowing, item }) => {
  let status = borrowing.status;
  let fine = borrowing.fineAmount;

  if (status === 'borrowed') {
    const calc = calculateFine(borrowing.dueDate);
    if (calc.isOverdue) {
      status = 'overdue';
      fine = Math.max(fine, calc.fineAmount);
    }
  }

  if (status === 'borrowed' || status === 'overdue') activeCount++;
  else if (status === 'pending') pendingCount++;
  else if (status === 'returned') returnedCount++;

  if (fine > 0 && !borrowing.finePaidAt) {
    totalFineUnpaid += fine;
  }

  return {
    ...borrowing,
    status,
    fineAmount: fine,
    item,
  };
});

const activeBorrowings = processedBorrowings.filter(
  (b) => b.status === 'borrowed' || b.status === 'overdue' || b.status === 'pending'
);

const userInitials = user.name
  .split(' ')
  .map((n) => n[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();

const maxLoanQuota = 3;
const usedQuota = Math.min(activeCount + pendingCount, maxLoanQuota);
const remainingQuota = Math.max(maxLoanQuota - (activeCount + pendingCount), 0);

// Segment widths for multi-color progress bar (like Job Level / Assignment widget)
const totalTransactions = Math.max(activeCount + pendingCount + returnedCount, 1);
const activePct = Math.round((activeCount / totalTransactions) * 100);
const pendingPct = Math.round((pendingCount / totalTransactions) * 100);
const returnedPct = Math.max(100 - activePct - pendingPct, 0);

const SHORT_MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
function getDueBadge(dateStr: string) {
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return { month: 'TGL', day: '--' };
  return {
    month: SHORT_MONTHS[d.getMonth()],
    day: String(d.getDate()).padStart(2, '0'),
  };
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — SIPEMBAR</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <script src="../../scripts/motion.ts"></script>
    <ClientRouter />
  </head>
  <body class="bg-[#F6F5FF] text-[#1E1B3A] min-h-screen flex flex-col pb-24 md:pb-8">
    <!-- Top Header -->
    <header transition:name="student-header" class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-[#1E1B3A]/10 shadow-xs">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        {/* Brand Logo & Mascot */}
        <a href="/katalog" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-2xl bg-amber-50 border border-amber-200/60 flex items-center justify-center shadow-xs group-hover:scale-105 transition">
            <Mascot mood="happy" size={28} />
          </div>
          <div>
            <span class="font-display text-lg font-bold tracking-tight text-[#1E1B3A] block leading-none">SIPEMBAR</span>
            <span class="text-[10px] text-gray-500 font-medium">Peminjaman Mandiri</span>
          </div>
        </a>

        {/* Desktop Navigation */}
        <nav class="hidden md:flex items-center gap-1.5 bg-[#F6F5FF] p-1 rounded-2xl border border-[#1E1B3A]/10">
          <a
            href="/katalog"
            class={`px-4 py-2 rounded-xl text-xs font-bold transition ${
              activeNav === 'katalog'
                ? 'bg-[#FF6B6B] text-white shadow-[0_2px_10px_rgba(255,107,107,0.35)]'
                : 'text-gray-600 hover:text-[#FF6B6B] hover:bg-white/80'
            }`}
          >
            Katalog
          </a>
          <a
            href="/pinjam"
            class={`px-4 py-2 rounded-xl text-xs font-bold transition ${
              activeNav === 'pinjam'
                ? 'bg-[#FF6B6B] text-white shadow-[0_2px_10px_rgba(255,107,107,0.35)]'
                : 'text-gray-600 hover:text-[#FF6B6B] hover:bg-white/80'
            }`}
          >
            Pinjam Mandiri
          </a>
          <a
            href="/riwayat"
            class={`px-4 py-2 rounded-xl text-xs font-bold transition ${
              activeNav === 'riwayat'
                ? 'bg-[#FF6B6B] text-white shadow-[0_2px_10px_rgba(255,107,107,0.35)]'
                : 'text-gray-600 hover:text-[#FF6B6B] hover:bg-white/80'
            }`}
          >
            Riwayat
          </a>
        </nav>

        {/* User Badge, Notifications & Profile Beranda Dropdown */}
        <div class="flex items-center gap-2.5">
          <!-- Notification Bell -->
          <a
            href="/notifikasi"
            class="relative p-2.5 rounded-xl bg-[#F6F5FF] text-gray-700 hover:bg-gray-100 transition border border-[#1E1B3A]/10"
            title="Notifikasi"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            {unreadCount > 0 && (
              <span class="absolute -top-1 -right-1 w-4 h-4 bg-[#FF6B6B] text-white text-[10px] font-bold rounded-full flex items-center justify-center animate-pulse">
                {unreadCount}
              </span>
            )}
          </a>

          <!-- Profile & Beranda Dropdown -->
          <div class="relative" id="profile-dropdown-container">
            <button
              type="button"
              id="profile-dropdown-trigger"
              aria-expanded="false"
              class="flex items-center gap-2.5 p-1.5 sm:pl-3 sm:pr-2.5 sm:py-1.5 rounded-2xl bg-white hover:bg-gray-50/90 border border-gray-200/80 transition cursor-pointer shadow-2xs"
            >
              <div class="hidden sm:block text-right">
                <span class="text-xs font-bold text-gray-900 block leading-tight">{user.name}</span>
                <span class="text-[10px] text-gray-400 font-mono">{user.nim_nip}</span>
              </div>
              <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-[#635BFF] to-[#4F46E5] text-white flex items-center justify-center text-xs font-bold shrink-0 shadow-2xs">
                {userInitials}
              </div>
              <svg
                id="profile-dropdown-chevron"
                class="w-3.5 h-3.5 text-gray-400 transition-transform duration-200"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Dropdown Panel (Modular Bento Widget Design) -->
            <div
              id="profile-dropdown-menu"
              class="hidden absolute right-0 mt-3 w-[355px] sm:w-[415px] bg-[#F4F5F9] p-3 rounded-[26px] border border-gray-200/90 shadow-[0_24px_60px_rgba(15,23,42,0.14)] z-50 space-y-2.5"
            >
              <!-- WIDGET 1: Profile & Sirkulasi Summary (Matches 'Job Level' & 'Assignment' Widget) -->
              <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-[0_2px_8px_rgba(15,23,42,0.03)] space-y-3.5">
                <!-- User Identity Top Row -->
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#635BFF] to-[#4F46E5] text-white flex items-center justify-center text-xs font-extrabold shrink-0 shadow-xs">
                      {userInitials}
                    </div>
                    <div class="min-w-0">
                      <h3 class="font-bold text-sm text-gray-900 truncate">{user.name}</h3>
                      <p class="text-[11px] text-gray-400 font-medium truncate">
                        NIM: <span class="font-mono text-gray-600">{user.nim_nip}</span> • {user.email}
                      </p>
                    </div>
                  </div>

                  <!-- Subtle Logout Action -->
                  <form method="POST" action="/api/auth/logout" class="shrink-0">
                    <button
                      type="submit"
                      class="px-2.5 py-1.5 rounded-xl bg-gray-50 hover:bg-rose-50 text-gray-500 hover:text-rose-600 border border-gray-200/70 hover:border-rose-200 text-[11px] font-semibold flex items-center gap-1 transition cursor-pointer"
                      title="Keluar Akun"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                      </svg>
                      <span>Keluar</span>
                    </button>
                  </form>
                </div>

                <div class="border-t border-gray-100"></div>

                <!-- Widget Title Row -->
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-1.5">
                    <span class="text-xs font-bold text-gray-800">Ringkasan Sirkulasi</span>
                    <span class="text-gray-300" title="Statistik peminjaman mandiri Anda">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    </span>
                  </div>
                  <span class="text-[11px] font-medium text-gray-400">
                    Kuota: <strong class="text-gray-700">{usedQuota}/{maxLoanQuota} terpakai</strong>
                  </span>
                </div>

                <!-- 4-Column Big Numbers with Hairline Vertical Dividers (Matches 'Job Level' & 'Total Learners') -->
                <div class="grid grid-cols-4 divide-x divide-gray-100 pt-0.5">
                  <div class="pr-2">
                    <span class="text-xl font-extrabold text-gray-900 tracking-tight block leading-none">{activeCount}</span>
                    <span class="text-[10px] font-medium text-gray-400 mt-1 block">
                      Dipinjam
                    </span>
                  </div>
                  <div class="px-2.5">
                    <span class="text-xl font-extrabold text-gray-900 tracking-tight block leading-none">{pendingCount}</span>
                    <span class="text-[10px] font-medium text-gray-400 mt-1 block">
                      Menunggu
                    </span>
                  </div>
                  <div class="px-2.5">
                    <span class="text-xl font-extrabold text-gray-900 tracking-tight block leading-none">{returnedCount}</span>
                    <span class="text-[10px] font-medium text-gray-400 mt-1 block">
                      Selesai
                    </span>
                  </div>
                  <div class="pl-2.5">
                    <span class="text-xl font-extrabold text-gray-900 tracking-tight block leading-none">{remainingQuota}</span>
                    <span class="text-[10px] font-medium text-gray-400 mt-1 block">
                      Sisa Kuota
                    </span>
                  </div>
                </div>

                <!-- Multi-Segment Horizontal Progress Bar -->
                <div class="space-y-2 pt-0.5">
                  <div class="w-full h-2 rounded-full bg-gray-100 overflow-hidden flex gap-0.5">
                    {activeCount > 0 && (
                      <div class="bg-[#635BFF] h-full rounded-full transition-all" style={`width: ${Math.max(activePct, 12)}%`}></div>
                    )}
                    {pendingCount > 0 && (
                      <div class="bg-amber-400 h-full rounded-full transition-all" style={`width: ${Math.max(pendingPct, 12)}%`}></div>
                    )}
                    {returnedCount > 0 && (
                      <div class="bg-emerald-500 h-full rounded-full transition-all" style={`width: ${Math.max(returnedPct, 12)}%`}></div>
                    )}
                  </div>

                  <!-- Denda Status Row -->
                  <div class="flex items-center justify-between text-[11px] pt-0.5">
                    <span class="text-gray-400 font-medium">Tagihan Denda</span>
                    <span class={`font-bold ${totalFineUnpaid > 0 ? 'text-rose-600' : 'text-emerald-600'}`}>
                      {totalFineUnpaid > 0 ? formatRupiah(totalFineUnpaid) : 'Rp 0'}
                    </span>
                  </div>
                </div>
              </div>

              <!-- WIDGET 2: Peminjaman Aktif (Matches 'Upcoming Interview' & 'Popular Jobs' Widget) -->
              <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-[0_2px_8px_rgba(15,23,42,0.03)] space-y-3">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span class="text-xs font-bold text-gray-800">Peminjaman Aktif</span>
                  </div>
                  <a href="/riwayat" class="text-[11px] font-semibold text-[#635BFF] hover:underline flex items-center gap-0.5">
                    <span>View more</span>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>

                {activeBorrowings.length === 0 ? (
                  <div class="py-5 px-3 rounded-xl bg-gray-50/70 border border-dashed border-gray-200 text-center space-y-1">
                    <p class="text-xs font-semibold text-gray-700">Belum ada barang dipinjam</p>
                    <p class="text-[11px] text-gray-400">Pilih barang di katalog atau pindai barcode untuk meminjam.</p>
                  </div>
                ) : (
                  <div class="space-y-2 max-h-56 overflow-y-auto pr-0.5">
                    {activeBorrowings.map((b) => {
                      const due = getDueBadge(b.dueDate);
                      const accentColor =
                        b.status === 'overdue'
                          ? 'border-l-rose-500'
                          : b.status === 'pending'
                          ? 'border-l-amber-400'
                          : 'border-l-emerald-500';
                      const statusTextColor =
                        b.status === 'overdue'
                          ? 'text-rose-600'
                          : b.status === 'pending'
                          ? 'text-amber-600'
                          : 'text-emerald-600';
                      const statusLabel =
                        b.status === 'overdue'
                          ? 'Terlambat'
                          : b.status === 'pending'
                          ? 'Menunggu ACC'
                          : 'Sedang Dipinjam';

                      return (
                        <a
                          href={`/riwayat/${b.borrowingCode}`}
                          class="flex items-center gap-3 p-2.5 rounded-xl bg-gray-50/60 hover:bg-gray-100/80 border border-gray-100 transition group"
                        >
                          <!-- Calendar Date Tile (Matches 'Feb 17' in Upcoming Interview widget) -->
                          <div class="w-11 h-11 rounded-xl bg-white border border-gray-200/80 flex flex-col items-center justify-center shrink-0 shadow-2xs">
                            <span class="text-[9px] font-bold uppercase text-gray-400 leading-none">{due.month}</span>
                            <span class="text-sm font-extrabold text-gray-900 leading-tight mt-0.5">{due.day}</span>
                          </div>

                          <!-- Vertical Accent Bar + Details (Matches 'Popular Jobs' & 'Upcoming Interview') -->
                          <div class={`flex-1 min-w-0 border-l-[3px] ${accentColor} pl-2.5 space-y-0.5`}>
                            <p class="text-xs font-bold text-gray-900 truncate group-hover:text-[#635BFF] transition">
                              {b.item.name}
                            </p>
                            <div class="flex items-center gap-2 text-[10px] text-gray-400">
                              <span>ID: <strong class="text-gray-600 font-mono">#{b.item.itemCode}</strong></span>
                              <span>•</span>
                              <span class={`font-semibold ${statusTextColor}`}>
                                {statusLabel}
                              </span>
                            </div>
                          </div>

                          <!-- Right Action Arrow -->
                          <div class="w-7 h-7 rounded-lg bg-white border border-gray-200/80 flex items-center justify-center text-gray-400 group-hover:text-[#635BFF] group-hover:border-[#635BFF]/30 transition shrink-0">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5l7 7-7 7" />
                            </svg>
                          </div>
                        </a>
                      );
                    })}
                  </div>
                )}

                <!-- Bottom Action Link Row (Matches 'See all assignment >' in reference widget) -->
                <div class="pt-2 border-t border-gray-100 flex items-center justify-between gap-2">
                  <a
                    href="/pinjam"
                    class="flex items-center justify-between w-full py-1.5 px-2 rounded-xl hover:bg-gray-50 transition group"
                  >
                    <div class="flex items-center gap-2">
                      <div class="w-6 h-6 rounded-lg bg-[#FF6B6B]/10 text-[#FF6B6B] flex items-center justify-center">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4" />
                        </svg>
                      </div>
                      <span class="text-xs font-bold text-gray-700 group-hover:text-gray-900">Pinjam Barang Mandiri</span>
                    </div>
                    <svg class="w-4 h-4 text-gray-400 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Container Slot -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 py-6">
      <slot />
    </main>

    <!-- Mobile Bottom Navigation Bar -->
    <nav transition:name="student-mobile-nav" class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-[#1E1B3A]/10 px-4 py-1.5 shadow-lg flex items-center justify-around">
      <a
        href="/katalog"
        class={`flex flex-col items-center py-1 px-4 rounded-xl text-[11px] font-semibold transition-colors ${
          activeNav === 'katalog' ? 'text-[#FF6B6B] font-bold' : 'text-gray-500'
        }`}
      >
        <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
        </svg>
        <span>Katalog</span>
      </a>

      {/* Primary Action Button: Pinjam Mandiri */}
      <a
        href="/pinjam"
        class={`flex flex-col items-center -top-4 relative py-1 px-4 bg-[#FF6B6B] text-white rounded-2xl shadow-[0_4px_14px_rgba(255,107,107,0.4)] border-2 transition-all active:scale-95 ${
          activeNav === 'pinjam' ? 'border-white ring-2 ring-[#FF6B6B]/40' : 'border-transparent'
        }`}
      >
        <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center mb-0.5">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
        </div>
        <span class="text-[10px] font-extrabold uppercase tracking-tight">Pinjam</span>
      </a>

      <a
        href="/riwayat"
        class={`flex flex-col items-center py-1 px-4 rounded-xl text-[11px] font-semibold transition-colors ${
          activeNav === 'riwayat' ? 'text-[#FF6B6B] font-bold' : 'text-gray-500'
        }`}
      >
        <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Riwayat</span>
      </a>
    </nav>

    <script>
      function initProfileDropdown() {
        const container = document.getElementById('profile-dropdown-container');
        const trigger = document.getElementById('profile-dropdown-trigger');
        const menu = document.getElementById('profile-dropdown-menu');
        const chevron = document.getElementById('profile-dropdown-chevron');

        if (!container || !trigger || !menu) return;

        // Avoid duplicate listeners on view transitions
        if (trigger.dataset.bound === 'true') return;
        trigger.dataset.bound = 'true';

        const toggleMenu = (forceClose = false) => {
          const isHidden = menu.classList.contains('hidden');
          if (forceClose || !isHidden) {
            menu.classList.add('hidden');
            trigger.setAttribute('aria-expanded', 'false');
            chevron?.classList.remove('rotate-180');
          } else {
            menu.classList.remove('hidden');
            trigger.setAttribute('aria-expanded', 'true');
            chevron?.classList.add('rotate-180');
          }
        };

        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleMenu();
        });

        document.addEventListener('click', (e) => {
          if (!container.contains(e.target as Node)) {
            toggleMenu(true);
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            toggleMenu(true);
          }
        });
      }

      initProfileDropdown();
      document.addEventListener('astro:page-load', initProfileDropdown);
    </script>
  </body>
</html>
