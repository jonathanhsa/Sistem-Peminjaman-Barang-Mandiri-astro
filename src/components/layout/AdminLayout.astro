---
import '../../styles/global.css';
import { getCurrentUser } from '../../lib/auth';
import { ClientRouter } from 'astro:transitions';

import { db, schema } from '../../db';
import { eq, desc } from 'drizzle-orm';
import { calculateFine } from '../../lib/fine';

interface Props {
  title?: string;
  activeNav?: 'dashboard' | 'barang' | 'peminjaman' | 'verifikasi' | 'laporan' | 'test-barcode';
}

const { title = 'Dasbor Admin — SIPEMBAR', activeNav = 'dashboard' } = Astro.props;

const user = await getCurrentUser(Astro.cookies);
if (!user) {
  return Astro.redirect('/login');
}
if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

// 1. Pending borrowing requests
const pendingBorrowings = await db
  .select({
    id: schema.borrowings.id,
    borrowingCode: schema.borrowings.borrowingCode,
    userName: schema.users.name,
    itemName: schema.items.name,
    createdAt: schema.borrowings.createdAt,
  })
  .from(schema.borrowings)
  .innerJoin(schema.items, eq(schema.borrowings.itemId, schema.items.id))
  .innerJoin(schema.users, eq(schema.borrowings.userId, schema.users.id))
  .where(eq(schema.borrowings.status, 'pending'))
  .orderBy(desc(schema.borrowings.createdAt))
  .all();

// 2. Active borrowings that are overdue or waiting for return scan
const activeBorrowings = await db
  .select({
    id: schema.borrowings.id,
    borrowingCode: schema.borrowings.borrowingCode,
    dueDate: schema.borrowings.dueDate,
    status: schema.borrowings.status,
    userName: schema.users.name,
    itemName: schema.items.name,
  })
  .from(schema.borrowings)
  .innerJoin(schema.items, eq(schema.borrowings.itemId, schema.items.id))
  .innerJoin(schema.users, eq(schema.borrowings.userId, schema.users.id))
  .all();

const returnPendingBorrowings = activeBorrowings.filter((b) => b.status === 'return_pending');
const overdueBorrowings = activeBorrowings.filter(
  (b) => (b.status === 'borrowed' || b.status === 'overdue' || b.status === 'return_pending') && calculateFine(b.dueDate).isOverdue
);

// 3. Out of stock inventory items
const outOfStockItems = await db
  .select({
    id: schema.items.id,
    name: schema.items.name,
    itemCode: schema.items.itemCode,
  })
  .from(schema.items)
  .where(eq(schema.items.stock, 0))
  .all();

interface AdminNotificationItem {
  id: string;
  title: string;
  message: string;
  type: 'warning' | 'danger' | 'info';
  link: string;
  badge: string;
}

const adminNotifs: AdminNotificationItem[] = [];

for (const r of returnPendingBorrowings) {
  adminNotifs.push({
    id: `return-pending-${r.id}`,
    title: 'Menunggu Scan Pengembalian di Loket',
    message: `${r.userName} mengajukan pengembalian ${r.itemName} (#${r.borrowingCode})`,
    type: 'info',
    link: '/admin/verifikasi',
    badge: 'Siap Kembali',
  });
}

for (const p of pendingBorrowings) {
  adminNotifs.push({
    id: `pending-${p.id}`,
    title: 'Permohonan Menunggu Persetujuan',
    message: `${p.userName} mengajukan pinjam ${p.itemName} (#${p.borrowingCode})`,
    type: 'warning',
    link: '/admin/peminjaman?tab=pending',
    badge: 'Menunggu ACC',
  });
}

for (const o of overdueBorrowings) {
  adminNotifs.push({
    id: `overdue-${o.id}`,
    title: 'Peminjaman Melewati Batas Tempo',
    message: `${o.userName} belum mengembalikan ${o.itemName} (#${o.borrowingCode})`,
    type: 'danger',
    link: '/admin/peminjaman?tab=aktif',
    badge: 'Terlambat',
  });
}

for (const s of outOfStockItems) {
  adminNotifs.push({
    id: `stock-${s.id}`,
    title: 'Stok Fisik Habis',
    message: `Barang ${s.name} (#${s.itemCode}) tersisa 0 unit`,
    type: 'info',
    link: '/admin/barang',
    badge: 'Stok 0',
  });
}

const totalNotifCount = adminNotifs.length;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — SIPEMBAR Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <script src="../../scripts/motion.ts"></script>
    <ClientRouter />
    <style>
      body, h1, h2, h3, h4, .font-display {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif !important;
      }
    </style>
  </head>
  <body class="bg-surface-admin text-ink-slate min-h-screen flex antialiased">
    
    <!-- ============================================================ -->
    <!-- PROFESSIONAL DESKTOP SIDEBAR (Icon & Label, Sleek SaaS Style) -->
    <!-- ============================================================ -->
    <aside class="hidden md:flex w-20 lg:w-64 bg-white border-r border-gray-100 flex-col justify-between shrink-0 fixed inset-y-0 left-0 z-30 transition-all duration-300">
      
      <!-- Top Logo & Navigation -->
      <div class="flex flex-col">
        <!-- Logo Header -->
        <div class="h-20 flex items-center px-4 lg:px-6 border-b border-gray-50">
          <a href="/admin/dashboard" class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-2xl bg-primary flex items-center justify-center text-white shadow-md shadow-primary/25 group-hover:scale-105 transition shrink-0">
              <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div class="hidden lg:block">
              <span class="text-base font-extrabold tracking-tight text-ink block leading-none">SIPEMBAR</span>
              <span class="text-[10px] font-bold text-primary uppercase tracking-wider">Panel Admin</span>
            </div>
          </a>
        </div>

        <!-- Navigation Links Stack -->
        <nav class="p-3 lg:p-4 space-y-1.5 overflow-y-auto">
          <!-- 1. Dashboard -->
          <a
            href="/admin/dashboard"
            class={`flex items-center gap-3.5 px-3 lg:px-3.5 py-3 rounded-xl text-xs font-bold transition-all group ${
              activeNav === 'dashboard'
                ? 'bg-primary-light text-primary shadow-xs'
                : 'text-gray-500 hover:bg-primary-light/50 hover:text-primary'
            }`}
            title="Dasbor"
          >
            <div class={`w-5 h-5 flex items-center justify-center shrink-0 ${activeNav === 'dashboard' ? 'text-primary' : 'text-gray-400 group-hover:text-primary'}`}>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
            </div>
            <span class="hidden lg:inline font-semibold">Dasbor</span>
          </a>

          <!-- 2. Barang -->
          <a
            href="/admin/barang"
            class={`flex items-center gap-3.5 px-3 lg:px-3.5 py-3 rounded-xl text-xs font-bold transition-all group ${
              activeNav === 'barang'
                ? 'bg-primary-light text-primary shadow-xs'
                : 'text-gray-500 hover:bg-primary-light/50 hover:text-primary'
            }`}
            title="Kelola Barang"
          >
            <div class={`w-5 h-5 flex items-center justify-center shrink-0 ${activeNav === 'barang' ? 'text-primary' : 'text-gray-400 group-hover:text-primary'}`}>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
            <span class="hidden lg:inline font-semibold">Kelola Inventaris</span>
          </a>

          <!-- 3. Peminjaman -->
          <a
            href="/admin/peminjaman"
            class={`flex items-center gap-3.5 px-3 lg:px-3.5 py-3 rounded-xl text-xs font-bold transition-all group ${
              activeNav === 'peminjaman'
                ? 'bg-primary-light text-primary shadow-xs'
                : 'text-gray-500 hover:bg-primary-light/50 hover:text-primary'
            }`}
            title="Peminjaman & ACC"
          >
            <div class={`w-5 h-5 flex items-center justify-center shrink-0 ${activeNav === 'peminjaman' ? 'text-primary' : 'text-gray-400 group-hover:text-primary'}`}>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
              </svg>
            </div>
            <span class="hidden lg:inline font-semibold">Peminjaman & ACC</span>
          </a>

          <!-- 4. Verifikasi QR -->
          <a
            href="/admin/verifikasi"
            class={`flex items-center gap-3.5 px-3 lg:px-3.5 py-3 rounded-xl text-xs font-bold transition-all group ${
              activeNav === 'verifikasi'
                ? 'bg-primary-light text-primary shadow-xs'
                : 'text-gray-500 hover:bg-primary-light/50 hover:text-primary'
            }`}
            title="Scan QR Loket"
          >
            <div class={`w-5 h-5 flex items-center justify-center shrink-0 ${activeNav === 'verifikasi' ? 'text-primary' : 'text-gray-400 group-hover:text-primary'}`}>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
              </svg>
            </div>
            <span class="hidden lg:inline font-semibold">Scan QR Loket</span>
          </a>

          <!-- 5. Laporan -->
          <a
            href="/admin/laporan"
            class={`flex items-center gap-3.5 px-3 lg:px-3.5 py-3 rounded-xl text-xs font-bold transition-all group ${
              activeNav === 'laporan'
                ? 'bg-primary-light text-primary shadow-xs'
                : 'text-gray-500 hover:bg-primary-light/50 hover:text-primary'
            }`}
            title="Laporan & Ekspor"
          >
            <div class={`w-5 h-5 flex items-center justify-center shrink-0 ${activeNav === 'laporan' ? 'text-primary' : 'text-gray-400 group-hover:text-primary'}`}>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <span class="hidden lg:inline font-semibold">Laporan Sirkulasi</span>
          </a>

          <!-- 6. Lembar Barcode -->
          <a
            href="/test-barcode"
            target="_blank"
            class="flex items-center gap-3.5 px-3 lg:px-3.5 py-3 rounded-xl text-xs font-bold text-gray-500 hover:bg-primary-light/50 hover:text-primary transition-all group"
            title="Buka Lembar Barcode"
          >
            <div class="w-5 h-5 flex items-center justify-center shrink-0 text-gray-400 group-hover:text-primary">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m-4-16v16m8-16v16M4 6v12m16-12v12" />
              </svg>
            </div>
            <span class="hidden lg:inline font-semibold">Lembar Barcode ↗</span>
          </a>
        </nav>
      </div>

      <!-- Bottom Profile & Logout -->
      <div class="p-3 lg:p-4 border-t border-gray-100 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="relative">
            <div class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm shadow-xs">
              {user.name.charAt(0).toUpperCase()}
            </div>
            <div class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-500 ring-2 ring-white"></div>
          </div>
          <div class="hidden lg:block text-left">
            <span class="text-xs font-bold text-gray-900 block truncate max-w-[110px]">{user.name}</span>
            <span class="text-[10px] text-gray-400 font-mono">Petugas Admin</span>
          </div>
        </div>

        <form method="POST" action="/api/auth/logout" class="hidden lg:block">
          <button
            type="submit"
            class="p-2 rounded-xl text-gray-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
            title="Keluar"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
          </button>
        </form>
      </div>
    </aside>

    <!-- ============================================================ -->
    <!-- MAIN WORKSPACE CONTAINER -->
    <!-- ============================================================ -->
    <div class="flex-1 flex flex-col min-w-0 md:pl-20 lg:pl-64">
      
      <!-- Top Header Navigation Bar (Matches SaaS Reference Image) -->
      <header class="h-20 bg-white border-b border-gray-100 px-4 sm:px-8 flex items-center justify-between gap-4 sticky top-0 z-20 shadow-[0_1px_2px_rgba(0,0,0,0.02)]">
        
        <!-- Left: Search Bar & Mobile Toggle -->
        <div class="flex items-center gap-3 sm:gap-4 flex-1 max-w-md">
          <!-- Mobile Menu Drawer Toggle -->
          <button
            type="button"
            id="mobile-drawer-btn"
            class="md:hidden p-2 rounded-xl text-gray-600 hover:bg-gray-100 transition cursor-pointer"
            title="Toggle Menu"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>

          <!-- Search Input with Magnifier -->
          <div class="relative w-full">
            <svg class="w-4 h-4 text-gray-400 absolute left-3.5 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              placeholder="Cari..."
              class="w-full pl-10 pr-4 py-2 bg-surface-soft border border-gray-200/80 rounded-xl text-xs text-gray-800 placeholder:text-gray-400 focus:outline-none focus:border-primary focus:bg-white transition"
            />
          </div>
        </div>

        <!-- Right: Actions, Language/Badge, Notifications, User -->
        <div class="flex items-center gap-3 sm:gap-4 shrink-0">

          <!-- Notification Bell with Functional Dropdown Menu -->
          <div class="relative" id="notif-container">
            <button
              type="button"
              id="notif-bell-btn"
              class="p-2.5 rounded-xl bg-gray-50 hover:bg-gray-100 text-gray-600 transition border border-gray-100 relative cursor-pointer"
              title="Pemberitahuan & Notifikasi"
              aria-label="Buka notifikasi admin"
              aria-expanded="false"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
              </svg>
              {totalNotifCount > 0 && (
                <span class="absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 rounded-full bg-primary text-white text-[10px] font-bold flex items-center justify-center ring-2 ring-white animate-pulse">
                  {totalNotifCount}
                </span>
              )}
            </button>

            <!-- Dropdown Flyout Panel -->
            <div
              id="notif-dropdown"
              class="hidden absolute right-0 mt-2.5 w-80 sm:w-96 bg-white rounded-2xl shadow-[0_12px_40px_rgba(0,0,0,0.12)] border border-gray-100 py-3 z-50 animate-fade-in"
            >
              <!-- Dropdown Header -->
              <div class="px-4 pb-2.5 border-b border-gray-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="font-extrabold text-sm text-ink">Pemberitahuan</span>
                  {totalNotifCount > 0 ? (
                    <span class="px-2 py-0.5 rounded-full bg-primary-light text-primary text-[10px] font-bold border border-primary/20">
                      {totalNotifCount} Tindakan
                    </span>
                  ) : (
                    <span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-600 text-[10px] font-bold">
                      Semua Beres
                    </span>
                  )}
                </div>
                <a
                  href="/admin/peminjaman"
                  class="text-[11px] font-bold text-primary hover:underline"
                >
                  Kelola Transaksi →
                </a>
              </div>

              <!-- List of Notifications -->
              <div class="max-h-80 overflow-y-auto divide-y divide-gray-50 py-1">
                {adminNotifs.length === 0 ? (
                  <div class="p-6 text-center space-y-1.5">
                    <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto text-sm font-bold">
                      ✓
                    </div>
                    <p class="text-xs font-bold text-ink">Tidak ada notifikasi baru</p>
                    <p class="text-[11px] text-gray-400">Semua permohonan telah diproses dan sirkulasi inventaris berjalan normal.</p>
                  </div>
                ) : (
                  adminNotifs.map((n) => (
                    <a
                      href={n.link}
                      class="px-4 py-3 hover:bg-surface-soft transition flex items-start gap-3 group block"
                    >
                      <div class={`w-8 h-8 rounded-xl flex items-center justify-center shrink-0 text-xs font-bold ${
                        n.type === 'danger'
                          ? 'bg-rose-50 text-rose-600 border border-rose-200/60'
                          : n.type === 'warning'
                          ? 'bg-amber-50 text-amber-600 border border-amber-200/60'
                          : 'bg-blue-50 text-blue-600 border border-blue-200/60'
                      }`}>
                        {n.type === 'danger' ? '⚠️' : n.type === 'warning' ? '⏳' : '📦'}
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between gap-1">
                          <h4 class="text-xs font-bold text-ink truncate group-hover:text-primary transition">
                            {n.title}
                          </h4>
                          <span class={`text-[9px] px-1.5 py-0.5 rounded-full font-bold ${
                            n.type === 'danger'
                              ? 'bg-rose-100 text-rose-700'
                              : n.type === 'warning'
                              ? 'bg-amber-100 text-amber-700'
                              : 'bg-blue-100 text-blue-700'
                          }`}>
                            {n.badge}
                          </span>
                        </div>
                        <p class="text-[11px] text-gray-500 line-clamp-2 mt-0.5 leading-snug">
                          {n.message}
                        </p>
                      </div>
                    </a>
                  ))
                )}
              </div>

              <!-- Dropdown Quick Shortcuts Footer -->
              <div class="px-4 pt-2 border-t border-gray-100 flex items-center justify-between text-[11px] text-gray-400">
                <a href="/admin/peminjaman?tab=pending" class="hover:text-primary font-semibold transition">
                  • Menunggu ACC ({pendingBorrowings.length})
                </a>
                <a href="/admin/peminjaman?tab=aktif" class="hover:text-primary font-semibold transition">
                  • Terlambat ({overdueBorrowings.length})
                </a>
              </div>
            </div>
          </div>

          <!-- User Avatar & Quick Info -->
          <div class="flex items-center gap-2.5 pl-2 sm:pl-3 border-l border-gray-100">
            <div class="relative">
              <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-bold text-xs shadow-xs">
                {user.name.charAt(0).toUpperCase()}
              </div>
              <div class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-500 ring-2 ring-white"></div>
            </div>
            <div class="hidden md:block text-left">
              <span class="text-xs font-bold text-gray-800 block leading-tight">{user.name.split(' ')[0]}</span>
              <span class="text-[10px] text-gray-400 font-mono">Petugas</span>
            </div>
          </div>
        </div>
      </header>

      <!-- Main Slot Content -->
      <main class="flex-1 p-4 sm:p-7 max-w-7xl w-full mx-auto">
        <slot />
      </main>

    </div>

    <!-- Mobile Slideover Drawer -->
    <div
      id="mobile-drawer"
      class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs hidden"
    >
      <div class="w-64 bg-white h-full p-5 flex flex-col justify-between shadow-2xl animate-fade-in">
        <div>
          <div class="flex items-center justify-between pb-6 border-b border-gray-100">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-primary flex items-center justify-center text-white font-bold text-sm shadow-xs">
                S
              </div>
              <span class="font-extrabold text-sm text-gray-900">SIPEMBAR Admin</span>
            </div>
            <button id="close-drawer-btn" class="p-1 rounded-lg text-gray-400 hover:text-gray-700 cursor-pointer">
              ✕
            </button>
          </div>

          <nav class="mt-4 space-y-1">
            <a href="/admin/dashboard" class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold ${activeNav === 'dashboard' ? 'bg-primary-light text-primary' : 'text-gray-600'}`}>
              Dasbor
            </a>
            <a href="/admin/barang" class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold ${activeNav === 'barang' ? 'bg-primary-light text-primary' : 'text-gray-600'}`}>
              Kelola Inventaris
            </a>
            <a href="/admin/peminjaman" class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold ${activeNav === 'peminjaman' ? 'bg-primary-light text-primary' : 'text-gray-600'}`}>
              Peminjaman & ACC
            </a>
            <a href="/admin/verifikasi" class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold ${activeNav === 'verifikasi' ? 'bg-primary-light text-primary' : 'text-gray-600'}`}>
              Scan QR Loket
            </a>
            <a href="/admin/laporan" class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold ${activeNav === 'laporan' ? 'bg-primary-light text-primary' : 'text-gray-600'}`}>
              Laporan Sirkulasi
            </a>
            <a href="/test-barcode" target="_blank" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold text-gray-600">
              Lembar Barcode ↗
            </a>
          </nav>
        </div>

        <form method="POST" action="/api/auth/logout" class="pt-4 border-t border-gray-100">
          <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-gray-100 text-gray-700 text-xs font-bold hover:bg-rose-50 hover:text-rose-600 transition flex items-center justify-center gap-2 cursor-pointer">
            <span>Keluar Akun</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Client Script for Drawer Toggle & Notifications Dropdown -->
    <script>
      function setupAdminInteractions() {
        // 1. Mobile Drawer
        const openBtn = document.getElementById('mobile-drawer-btn');
        const closeBtn = document.getElementById('close-drawer-btn');
        const drawer = document.getElementById('mobile-drawer');

        if (openBtn && drawer) {
          openBtn.onclick = () => drawer.classList.remove('hidden');
        }
        if (closeBtn && drawer) {
          closeBtn.onclick = () => drawer.classList.add('hidden');
        }
        if (drawer) {
          drawer.onclick = (e) => {
            if (e.target === drawer) drawer.classList.add('hidden');
          };
        }

        // 2. Notification Bell Dropdown
        const bellBtn = document.getElementById('notif-bell-btn');
        const dropdown = document.getElementById('notif-dropdown');

        if (bellBtn && dropdown) {
          bellBtn.onclick = (e) => {
            e.stopPropagation();
            dropdown.classList.toggle('hidden');
          };

          document.addEventListener('click', (e) => {
            const target = e.target as Node;
            if (!dropdown.contains(target) && target !== bellBtn && !bellBtn.contains(target)) {
              dropdown.classList.add('hidden');
            }
          });

          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
              dropdown.classList.add('hidden');
            }
          });
        }
      }

      setupAdminInteractions();
      document.addEventListener('astro:page-load', setupAdminInteractions);
    </script>
  </body>
</html>
