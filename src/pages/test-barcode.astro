---
import '../styles/global.css';
import { db, schema } from '../db';
import { BarcodeSvg } from '../components/scanner/BarcodeSvg';
import { QRCodeSVG } from 'qrcode.react';
import { Mascot } from '../components/illustrations/Mascot';

// Fetch the 10 library books for barcode testing
const allItems = await db.select().from(schema.items).all();
const libraryBooks = allItems.filter((i) => i.itemCode.startsWith('LIB-'));
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lembar Pengujian Barcode & OCR (10 Buku Perpustakaan) — SIPEMBAR</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <style>
      @media print {
        .no-print {
          display: none !important;
        }
        body {
          background-color: white !important;
          color: black !important;
        }
        .page-break {
          break-inside: avoid;
        }
      }
    </style>
  </head>
  <body class="bg-[#F6F5FF] text-[#1E1B3A] p-4 sm:p-8 min-h-screen">
    <div class="max-w-6xl mx-auto space-y-6">
      {/* Top Bar / Print Action */}
      <div class="no-print bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-[0_10px_35px_rgba(30,27,58,0.06)] flex flex-col sm:flex-row items-center justify-between gap-5">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-amber-50 border border-amber-200/60 flex items-center justify-center p-1 shadow-2xs shrink-0">
            <Mascot mood="scanning" size={40} />
          </div>
          <div>
            <div class="inline-block bg-[#FF6B6B] text-white text-[10px] font-bold px-3 py-0.5 rounded-full uppercase tracking-wider mb-1.5 shadow-[0_2px_10px_rgba(255,107,107,0.35)]">
              Lembar Cetak Label Fisik Inventaris
            </div>
            <h1 class="text-xl sm:text-2xl font-extrabold font-display text-[#1E1B3A] tracking-tight">
              Katalog Label Barcode Perpustakaan (Code 128 + QR Code + OCR)
            </h1>
            <p class="text-xs text-gray-500 mt-0.5">
              Lembar stiker inventaris untuk ditempel pada buku fisik dan dipindai saat sirkulasi peminjaman mandiri.
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
          <a
            href="/pinjam"
            class="px-4 py-2.5 rounded-2xl bg-rose-50 border border-rose-200 text-[#FF6B6B] text-xs font-bold hover:bg-rose-100 transition shadow-2xs"
          >
            ← Buka Scanner Pinjam
          </a>
          <button
            onclick="window.print()"
            class="px-5 py-2.5 btn-coral text-xs font-bold rounded-2xl flex items-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Cetak Lembar Uji
          </button>
        </div>
      </div>

      {/* Grid of 10 Books */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {libraryBooks.map((item, index) => (
          <div class="page-break bg-white rounded-3xl p-6 border-2 border-[#1E1B3A]/15 shadow-md flex flex-col justify-between hover:shadow-lg transition">
            <!-- Header Info -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-lg bg-indigo-50 text-[#3B3FD9] border border-indigo-200">
                  #{index + 1} • {item.itemCode}
                </span>
                <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                  Stok: {item.stock} eks.
                </span>
              </div>
              <h3 class="text-base font-bold text-[#1E1B3A] font-display line-clamp-2">
                {item.name}
              </h3>
              <p class="text-xs text-gray-500 mt-0.5">Kategori: {item.category}</p>
            </div>

            <!-- Codes Visualization Box -->
            <div class="mt-4 pt-4 border-t-2 border-dashed border-gray-200 grid grid-cols-1 sm:grid-cols-2 gap-4 items-center bg-[#F6F5FF] p-4 rounded-2xl">
              <!-- QR Code Column -->
              <div class="flex flex-col items-center justify-center bg-white p-3 rounded-xl border border-gray-200 shadow-xs">
                <span class="text-[10px] uppercase font-bold text-gray-500 mb-1.5 tracking-wider">
                  QR Code Matrix
                </span>
                <QRCodeSVG
                  value={item.itemCode}
                  size={100}
                  level="M"
                  includeMargin={true}
                  fgColor="#1E1B3A"
                />
              </div>

              <!-- Barcode 1D Column -->
              <div class="flex flex-col items-center justify-center bg-white p-3 rounded-xl border border-gray-200 shadow-xs overflow-hidden">
                <span class="text-[10px] uppercase font-bold text-gray-500 mb-1.5 tracking-wider">
                  Barcode Code 128
                </span>
                <BarcodeSvg value={item.itemCode} height={42} barWidth={1.6} />
              </div>
            </div>

            <!-- OCR Target Serial Label -->
            <div class="mt-3 bg-white p-2.5 rounded-xl border border-gray-200 flex items-center justify-between">
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-wider">
                Target Teks OCR:
              </span>
              <span class="font-mono text-sm font-extrabold tracking-widest text-[#1E1B3A] bg-amber-100 px-2.5 py-0.5 rounded border border-amber-300">
                {item.itemCode}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </body>
</html>
