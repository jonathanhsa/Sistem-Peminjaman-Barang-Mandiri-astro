---
import StudentLayout from '../components/layout/StudentLayout.astro';
import { getCurrentUser } from '../lib/auth';
import { BorrowScannerView } from '../components/scanner/BorrowScannerView';

const user = await getCurrentUser(Astro.cookies);
if (!user) return Astro.redirect('/login');

const initialCode = (Astro.url.searchParams.get('code') || '').trim();
if (initialCode) {
  return Astro.redirect(`/pinjam/form?code=${encodeURIComponent(initialCode)}`);
}
const errorParam = Astro.url.searchParams.get('error') || null;
---

<StudentLayout title="Scan Barcode Pinjam Mandiri" activeNav="pinjam">
  <div class="space-y-4">
    <!-- Breadcrumb Header -->
    <div class="flex items-center justify-between">
      <a href="/dashboard" class="text-xs font-semibold text-gray-500 hover:text-[#FF6B6B] flex items-center gap-1 transition">
        ← Kembali ke Beranda
      </a>
      <a href="/katalog" class="text-xs font-semibold text-[#FF6B6B] bg-rose-50 px-3 py-1.5 rounded-xl hover:bg-rose-100 transition shadow-2xs">
        Lihat Katalog Barang →
      </a>
    </div>

    <!-- Scanner-First View -->
    <div>
      <BorrowScannerView
        client:load
        currentUser={{
          name: user.name,
          nim_nip: user.nim_nip,
        }}
        initialError={errorParam}
      />
    </div>
  </div>
</StudentLayout>
