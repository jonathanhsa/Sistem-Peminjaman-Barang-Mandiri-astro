---
import '../styles/global.css';
import { getCurrentUser } from '../lib/auth';
import { Mascot } from '../components/illustrations/Mascot';
import { ClientRouter } from 'astro:transitions';

const user = await getCurrentUser(Astro.cookies);
if (user) {
  if (user.role === 'admin') return Astro.redirect('/admin/dashboard');
  return Astro.redirect('/dashboard');
}

const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — SIPEMBAR Kampus</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <script src="../scripts/motion.ts"></script>
    <ClientRouter />
    <style>
      /* Smooth input focus underline transitions */
      .underline-input-group {
        position: relative;
        transition: all 0.2s ease;
      }
      .underline-input-group::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background-color: #FF6B6B;
        transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .underline-input-group:focus-within::after {
        width: 100%;
      }
      .underline-input-group:focus-within svg.input-icon {
        color: #FF6B6B;
      }
      /* Custom Coral Button */
      .btn-coral {
        background-color: #FF6B6B;
        color: #ffffff;
        box-shadow: 0 4px 14px rgba(255, 107, 107, 0.35);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .btn-coral:hover {
        background-color: #f75555;
        box-shadow: 0 6px 20px rgba(255, 107, 107, 0.45);
        transform: translateY(-1px);
      }
      .btn-coral:active {
        transform: translateY(1px);
        box-shadow: 0 2px 8px rgba(255, 107, 107, 0.3);
      }
    </style>
  </head>
  <body class="bg-[#F8F7FF] text-[#1E1B3A] min-h-screen antialiased selection:bg-[#FF6B6B] selection:text-white">
    <div class="min-h-screen w-full flex flex-col lg:flex-row">
      
      <!-- ============================================================ -->
      <!-- MOBILE ONLY: Top Bookshelf Hero Background with Organic Wave -->
      <!-- ============================================================ -->
      <div class="relative w-full h-[36vh] min-h-[230px] max-h-[310px] lg:hidden overflow-hidden bg-stone-900 shrink-0">
        <!-- Pure Bookshelf Image -->
        <img
          src="/images/bookshelf-bg.jpg"
          alt="Rak Buku Perpustakaan SIPEMBAR"
          class="w-full h-full object-cover object-center filter brightness-[0.95]"
        />

        <!-- Organic Wave Curve Transition at Bottom of Hero -->
        <div class="absolute -bottom-[1px] left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">
          <svg viewBox="0 0 500 80" preserveAspectRatio="none" class="w-full h-16 sm:h-20 text-white fill-current block">
            <path d="M 0,30 C 140,5 280,80 500,25 L 500,80 L 0,80 Z"></path>
          </svg>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- AUTHENTICATION SECTION (Left on Desktop, Bottom Card on Mobile) -->
      <!-- ============================================================ -->
      <div class="flex-1 w-full lg:w-[46%] xl:w-[42%] bg-white flex flex-col justify-between px-6 sm:px-12 lg:px-14 xl:px-18 pt-6 pb-12 sm:py-10 lg:py-12 relative z-20 min-h-[calc(100vh-240px)] lg:min-h-screen shadow-[12px_0_35px_rgba(0,0,0,0.06)]">
        
        <!-- Desktop Brand Header (Hidden on Mobile) -->
        <div class="hidden lg:flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-amber-50 border border-amber-200/60 flex items-center justify-center shadow-xs">
            <Mascot mood="happy" size={28} />
          </div>
          <div>
            <h2 class="font-display font-bold text-lg text-gray-900 leading-tight">SIPEMBAR</h2>
            <p class="text-[11px] text-gray-500 font-medium">Sistem Peminjaman Barang Mandiri</p>
          </div>
        </div>

        <!-- Form Card Container -->
        <div class="w-full max-w-sm sm:max-w-md mx-auto my-auto py-2">
          
          <!-- Title & Coral Accent Line -->
          <div data-animate="fade-up" class="mb-7">
            <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1E1B3A] tracking-tight font-display">
              Sign in
            </h1>
            <!-- Accent Coral Underline Bar (Matches reference mockup) -->
            <div class="w-11 h-1 bg-[#FF6B6B] rounded-full mt-2"></div>
            <p class="text-xs sm:text-sm text-gray-500 mt-3 font-normal">
              Masukkan akun kampus Anda untuk mulai meminjam barang & buku.
            </p>
          </div>

          <!-- Error Alert Banner -->
          {error && (
            <div class="mb-6 p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold flex items-center gap-2.5 animate-shake">
              <svg class="w-4 h-4 shrink-0 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>{error}</span>
            </div>
          )}

          <!-- Sign In Form -->
          <form method="POST" action="/api/auth/login" class="space-y-6" id="login-form">
            
            <!-- Email / Identifier Input Field -->
            <div class="space-y-1.5">
              <label for="identifier" class="block text-xs font-semibold text-gray-600">
                Email
              </label>
              <div class="underline-input-group flex items-center gap-3 border-b-2 border-gray-200 py-2.5">
                <!-- Mail Icon -->
                <svg class="input-icon w-5 h-5 text-gray-400 shrink-0 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <input
                  id="identifier"
                  name="identifier"
                  type="text"
                  required
                  placeholder="demo@email.com"
                  class="w-full bg-transparent text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none"
                  autocomplete="username"
                />
              </div>
            </div>

            <!-- Password Input Field with Toggle -->
            <div class="space-y-1.5">
              <label for="password" class="block text-xs font-semibold text-gray-600">
                Password
              </label>
              <div class="underline-input-group flex items-center gap-3 border-b-2 border-gray-200 py-2.5">
                <!-- Lock Icon -->
                <svg class="input-icon w-5 h-5 text-gray-400 shrink-0 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  placeholder="enter your password"
                  class="w-full bg-transparent text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none"
                  autocomplete="current-password"
                />
                <!-- Eye Toggle Button -->
                <button
                  type="button"
                  id="toggle-password"
                  aria-label="Tampilkan atau sembunyikan kata sandi"
                  class="text-gray-400 hover:text-gray-600 p-1 focus:outline-none transition-colors"
                >
                  <svg id="eye-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  <svg id="eye-off-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Remember Me & Forgot Password Row -->
            <div class="flex items-center justify-between text-xs pt-1">
              <label class="flex items-center gap-2 cursor-pointer select-none text-gray-600 font-medium hover:text-gray-900 transition-colors">
                <input
                  type="checkbox"
                  name="remember"
                  class="w-4 h-4 rounded text-[#FF6B6B] accent-[#FF6B6B] border-gray-300 focus:ring-[#FF6B6B] cursor-pointer"
                />
                <span>Remember Me</span>
              </label>
              
              <button
                type="button"
                id="forgot-password-btn"
                class="text-[#FF6B6B] hover:text-[#e85b4b] font-semibold transition-colors focus:outline-none"
              >
                Forgot Password?
              </button>
            </div>

            <!-- Pill Login Button -->
            <div class="pt-2">
              <button
                type="submit"
                id="submit-btn"
                class="w-full py-3.5 px-6 btn-coral rounded-full text-sm font-bold tracking-wide flex items-center justify-center gap-2 transition"
              >
                <span>Login</span>
              </button>
            </div>
          </form>

          <!-- Sign Up Link (Footer of Form) -->
          <div class="mt-8 text-center text-xs text-gray-500">
            <span>Don't have an Account ? </span>
            <a href="/register" class="text-[#FF6B6B] font-bold hover:underline transition-colors">
              Sign up
            </a>
          </div>

        </div>

        <!-- Simple Clean Empty Spacer -->
        <div class="hidden lg:block h-2"></div>
      </div>

      <!-- ============================================================ -->
      <!-- DESKTOP ONLY: Right Bookshelf Visual (Pure, Clean Background) -->
      <!-- ============================================================ -->
      <div class="hidden lg:block lg:w-[54%] xl:w-[58%] relative overflow-hidden bg-stone-900">
        <!-- Bookshelf High-Res Background Image -->
        <img
          src="/images/bookshelf-bg.jpg"
          alt="Rak Buku Perpustakaan"
          class="w-full h-full object-cover object-center filter brightness-[0.96]"
        />
      </div>

    </div>

    <!-- ============================================================ -->
    <!-- FORGOT PASSWORD MODAL DIALOG -->
    <!-- ============================================================ -->
    <div id="forgot-modal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs hidden items-center justify-center p-4">
      <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-sm w-full shadow-2xl border border-gray-100 text-center space-y-4 animate-scale-in">
        <div class="w-14 h-14 mx-auto rounded-2xl bg-rose-50 text-[#FF6B6B] flex items-center justify-center text-2xl">
          🔑
        </div>
        <div>
          <h3 class="font-display font-bold text-lg text-gray-900">Lupa Kata Sandi?</h3>
          <p class="text-xs text-gray-500 mt-2 leading-relaxed">
            Untuk mereset kata sandi akun kampus Anda, silakan hubungi petugas perpustakaan atau staf inventaris di:
          </p>
          <div class="mt-3 p-3 bg-gray-50 rounded-xl text-xs font-mono font-medium text-gray-700 select-all border border-gray-200">
            perpustakaan@kampus.ac.id
          </div>
          <p class="text-[11px] text-gray-400 mt-2">
            Atau kunjungi meja administrasi lantai 1 gedung perpustakaan utama.
          </p>
        </div>
        <button
          type="button"
          id="close-modal-btn"
          class="w-full py-2.5 px-4 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-xl text-xs font-bold transition"
        >
          Mengerti & Tutup
        </button>
      </div>
    </div>

    <!-- Client Script for Interactive Password Toggle & Modal -->
    <script>
      // Toggle Password Visibility
      const togglePasswordBtn = document.getElementById('toggle-password');
      const passwordInput = document.getElementById('password') as HTMLInputElement | null;
      const eyeIcon = document.getElementById('eye-icon');
      const eyeOffIcon = document.getElementById('eye-off-icon');

      if (togglePasswordBtn && passwordInput && eyeIcon && eyeOffIcon) {
        togglePasswordBtn.addEventListener('click', () => {
          const isPassword = passwordInput.type === 'password';
          passwordInput.type = isPassword ? 'text' : 'password';
          eyeIcon.classList.toggle('hidden', isPassword);
          eyeOffIcon.classList.toggle('hidden', !isPassword);
        });
      }

      // Forgot Password Modal
      const forgotBtn = document.getElementById('forgot-password-btn');
      const forgotModal = document.getElementById('forgot-modal');
      const closeModalBtn = document.getElementById('close-modal-btn');

      if (forgotBtn && forgotModal && closeModalBtn) {
        forgotBtn.addEventListener('click', () => {
          forgotModal.classList.remove('hidden');
          forgotModal.classList.add('flex');
        });

        closeModalBtn.addEventListener('click', () => {
          forgotModal.classList.add('hidden');
          forgotModal.classList.remove('flex');
        });

        forgotModal.addEventListener('click', (e) => {
          if (e.target === forgotModal) {
            forgotModal.classList.add('hidden');
            forgotModal.classList.remove('flex');
          }
        });
      }

      // Loading state on submit
      const loginForm = document.getElementById('login-form');
      const submitBtn = document.getElementById('submit-btn');
      if (loginForm && submitBtn) {
        loginForm.addEventListener('submit', () => {
          submitBtn.setAttribute('disabled', 'true');
          submitBtn.classList.add('opacity-80', 'cursor-not-allowed');
          submitBtn.innerHTML = `
            <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Memproses Masuk...</span>
          `;
        });
      }
    </script>
  </body>
</html>
