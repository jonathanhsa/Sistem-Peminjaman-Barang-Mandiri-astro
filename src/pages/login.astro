---
import '../styles/global.css';
import { getCurrentUser } from '../lib/auth';
import { Mascot } from '../components/illustrations/Mascot';

const user = await getCurrentUser(Astro.cookies);
if (user) {
  if (user.role === 'admin') return Astro.redirect('/admin/dashboard');
  return Astro.redirect('/dashboard');
}

const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Masuk — SIPEMBAR Kampus</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <script src="../scripts/motion.ts"></script>
  </head>
  <body class="bg-[#F6F5FF] text-[#1E1B3A] min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md">
      <!-- Mascot & Brand Card -->
      <div data-animate="fade-up" class="text-center mb-6">
        <div class="inline-block relative mb-2">
          <Mascot mood="happy" size={110} />
        </div>
        <h1 class="text-3xl font-bold font-display text-[#1E1B3A] tracking-tight">SIPEMBAR</h1>
        <p class="text-sm text-gray-600 mt-1">Sistem Peminjaman Barang Mandiri Kampus</p>
      </div>

      <!-- Login Card -->
      <div data-animate="fade-up" class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-[#1E1B3A]/10 shadow-xl relative">
        <h2 class="text-xl font-bold font-display text-[#1E1B3A] mb-1">Selamat Datang! 👋</h2>
        <p class="text-xs text-gray-500 mb-6">Masukkan NIM / NIP dan kata sandi Anda</p>

        {error && (
          <div class="mb-5 p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>{error}</span>
          </div>
        )}

        <form method="POST" action="/api/auth/login" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" for="identifier">
              NIM / NIP / Email
            </label>
            <input
              id="identifier"
              name="identifier"
              type="text"
              required
              placeholder="Contoh: 220101001 atau admin@kampus.ac.id"
              class="w-full px-4 py-3 rounded-2xl border-2 border-gray-200 text-sm focus:outline-none focus:border-[#3B3FD9] transition"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" for="password">
              Kata Sandi
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              placeholder="••••••••"
              class="w-full px-4 py-3 rounded-2xl border-2 border-gray-200 text-sm focus:outline-none focus:border-[#3B3FD9] transition"
            />
          </div>

          <button
            type="submit"
            class="w-full py-3.5 px-4 btn-sticker-primary text-sm font-bold tracking-wide mt-2"
          >
            Masuk ke Aplikasi
          </button>
        </form>

        {/* Registration & Help Links */}
        <div class="mt-6 pt-5 border-t border-gray-100 space-y-3 text-center">
          <p class="text-xs text-gray-500">
            Mahasiswa baru belum memiliki akun?{' '}
            <a href="/register" class="text-[#3B3FD9] font-bold hover:underline">
              Daftar Mandiri Disini
            </a>
          </p>
          <p class="text-[11px] text-gray-400">
            Petugas atau staf inventaris menggunakan akun email institusi resmi.
          </p>
        </div>
      </div>

      <!-- Footer Info -->
      <div class="mt-6 text-center text-xs text-gray-400">
        <p>© 2026 SIPEMBAR • Sistem Peminjaman Barang Mandiri Kampus</p>
      </div>
    </div>
  </body>
</html>
