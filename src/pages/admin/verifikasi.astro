---
import AdminLayout from '../../components/layout/AdminLayout.astro';
import { AdminVerification } from '../../components/scanner/AdminVerification';
---

<AdminLayout title="Verifikasi QR Bukti Transaksi" activeNav="verifikasi">
  <div class="max-w-2xl mx-auto space-y-4">
    <div class="flex items-center justify-between">
      <a href="/admin/dashboard" class="text-xs font-bold text-gray-500 hover:text-[#3B3FD9]">
        ← Kembali ke Dashboard
      </a>
      <span class="text-xs text-gray-400">Loket Layanan Mandiri</span>
    </div>

    <!-- Interactive Verification Island -->
    <AdminVerification client:load />
  </div>
</AdminLayout>
