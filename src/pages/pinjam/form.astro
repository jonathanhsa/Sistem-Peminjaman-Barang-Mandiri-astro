---
import StudentLayout from '../../components/layout/StudentLayout.astro';
import { getCurrentUser } from '../../lib/auth';
import { db, schema } from '../../db';
import { eq, and, gt, isNull, inArray } from 'drizzle-orm';
import { BorrowConfirmForm } from '../../components/borrowing/BorrowConfirmForm';

const user = await getCurrentUser(Astro.cookies);
if (!user) return Astro.redirect('/login');

const code = (Astro.url.searchParams.get('code') || '').trim().toUpperCase();
if (!code) {
  return Astro.redirect('/pinjam');
}

// 1. Fetch item by code
const item = await db
  .select()
  .from(schema.items)
  .where(eq(schema.items.itemCode, code))
  .get();

if (!item) {
  return Astro.redirect('/pinjam?error=Barang+tidak+ditemukan');
}

// 2. Check unpaid fines
const unpaidFineRecord = await db
  .select()
  .from(schema.borrowings)
  .where(
    and(
      eq(schema.borrowings.userId, user.id),
      gt(schema.borrowings.fineAmount, 0),
      isNull(schema.borrowings.finePaidAt)
    )
  )
  .get();

const hasUnpaidFine = !!unpaidFineRecord;
const unpaidFineAmount = unpaidFineRecord ? unpaidFineRecord.fineAmount : 0;

// 3. Check active loans count
const activeLoans = await db
  .select()
  .from(schema.borrowings)
  .where(
    and(
      eq(schema.borrowings.userId, user.id),
      inArray(schema.borrowings.status, ['pending', 'borrowed', 'overdue'])
    )
  )
  .all();

const activeLoansCount = activeLoans.length;

const itemData = {
  id: item.id,
  name: item.name,
  item_code: item.itemCode,
  category: item.category,
  stock: item.stock,
  is_available: item.status === 'available' && item.stock > 0,
};
---

<StudentLayout title={`Formulir Pinjam — ${item.name}`} activeNav="pinjam">
  <div class="py-2">
    <BorrowConfirmForm
      client:load
      item={itemData}
      hasUnpaidFine={hasUnpaidFine}
      unpaidFineAmount={unpaidFineAmount}
      activeLoansCount={activeLoansCount}
      currentUser={{
        name: user.name,
        nim_nip: user.nim_nip,
        email: user.email,
      }}
    />
  </div>
</StudentLayout>
