---
import StudentLayout from '../../components/layout/StudentLayout.astro';
import { getCurrentUser } from '../../lib/auth';
import { db, schema } from '../../db';
import { eq, desc } from 'drizzle-orm';
import { StatusBadge } from '../../components/borrowing/StatusBadge';
import { CountdownBadge } from '../../components/borrowing/CountdownBadge';
import { formatDate } from '../../lib/format-date';
import { formatRupiah } from '../../lib/format-rupiah';
import { CategoryIcon } from '../../components/illustrations/CategoryIcon';
import { calculateFine } from '../../lib/fine';

const user = await getCurrentUser(Astro.cookies);
if (!user) return Astro.redirect('/login');

const filter = (Astro.url.searchParams.get('status') || 'semua').toLowerCase();

const borrowings = await db
  .select({
    borrowing: schema.borrowings,
    item: schema.items,
  })
  .from(schema.borrowings)
  .innerJoin(schema.items, eq(schema.borrowings.itemId, schema.items.id))
  .where(eq(schema.borrowings.userId, user.id))
  .orderBy(desc(schema.borrowings.createdAt))
  .all();

const processed = borrowings.map(({ borrowing, item }) => {
  let status = borrowing.status;
  let fine = borrowing.fineAmount;

  if (status === 'borrowed' || status === 'overdue' || status === 'return_pending') {
    const calc = calculateFine(borrowing.dueDate);
    if (calc.isOverdue) {
      if (status === 'borrowed') status = 'overdue';
      fine = Math.max(fine, calc.fineAmount);
    }
  }

  return {
    ...borrowing,
    status,
    fineAmount: fine,
    item,
  };
});

const filtered = processed.filter((b) => {
  if (filter === 'berjalan') return b.status === 'borrowed' || b.status === 'pending' || b.status === 'return_pending';
  if (filter === 'terlambat') return b.status === 'overdue' || (b.status === 'return_pending' && b.fineAmount > 0);
  if (filter === 'selesai') return b.status === 'returned' || b.status === 'rejected';
  return true;
});
---

<StudentLayout title="Riwayat Peminjaman" activeNav="riwayat">
  <div class="space-y-6">
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-[0_10px_35px_rgba(30,27,58,0.06)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold font-display text-ink tracking-tight">Riwayat Transaksi Peminjaman</h1>
        <div class="w-11 h-1 bg-primary rounded-full mt-2"></div>
        <p class="text-xs text-gray-500 mt-2">Daftar semua permohonan pinjam, bukti QR, dan status barang inventaris</p>
      </div>

      <a
        href="/pinjam"
        class="btn-coral px-5 py-2.5 rounded-full text-xs font-bold transition flex items-center gap-2 cursor-pointer shrink-0"
      >
        <span>Pinjam Barang Baru</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
      </a>
    </div>

    <!-- Filter Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-1">
      {[
        { id: 'semua', label: 'Semua Transaksi' },
        { id: 'berjalan', label: 'Sedang Berjalan' },
        { id: 'terlambat', label: 'Terlambat / Denda' },
        { id: 'selesai', label: 'Selesai Dikembalikan' },
      ].map((tab) => (
        <a
          href={`/riwayat?status=${tab.id}`}
          class={`px-4 py-2 rounded-2xl text-xs font-bold whitespace-nowrap transition ${
            filter === tab.id
              ? 'bg-primary text-white shadow-[0_2px_10px_rgba(255,107,107,0.35)]'
              : 'bg-white text-gray-600 border border-gray-200 hover:text-primary hover:bg-gray-50'
          }`}
        >
          {tab.label}
        </a>
      ))}
    </div>

    <!-- Transaction List -->
    {filtered.length === 0 ? (
      <div class="bg-white rounded-3xl p-12 text-center border border-gray-100 shadow-[0_10px_35px_rgba(30,27,58,0.06)] space-y-3">
        <div class="w-16 h-16 rounded-full bg-rose-50 text-primary flex items-center justify-center mx-auto text-2xl font-bold">
          📑
        </div>
        <h3 class="text-base font-bold text-ink">Belum ada data riwayat</h3>
        <p class="text-xs text-gray-500 max-w-sm mx-auto">
          Tidak ada data transaksi yang cocok dengan filter yang dipilih.
        </p>
      </div>
    ) : (
      <div class="space-y-3.5">
        {filtered.map((b) => (
          <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-[0_10px_35px_rgba(30,27,58,0.06)] flex flex-col md:flex-row md:items-center justify-between gap-4 hover:shadow-md transition">
            <div class="flex items-start gap-3.5">
              <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-800 flex items-center justify-center shrink-0 border border-amber-200/50 shadow-2xs">
                <CategoryIcon category={b.item.category} size={22} />
              </div>
              <div class="space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-mono text-xs font-bold text-gray-600 bg-gray-100 px-2.5 py-0.5 rounded-lg">
                    {b.borrowingCode}
                  </span>
                  <StatusBadge status={b.status} size="sm" />
                  <CountdownBadge dueDate={b.dueDate} status={b.status} />
                </div>
                <h3 class="font-bold text-sm sm:text-base text-ink">
                  {b.item.name}
                </h3>
                <div class="flex items-center gap-4 text-xs text-gray-500 flex-wrap">
                  <span>Pinjam: <strong>{formatDate(b.borrowDate)}</strong></span>
                  <span>Batas: <strong class="text-rose-600">{formatDate(b.dueDate)}</strong></span>
                  {b.fineAmount > 0 && (
                    <span class="font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded-md border border-rose-200">
                      Denda: {formatRupiah(b.fineAmount)}
                    </span>
                  )}
                </div>
              </div>
            </div>

            <div class="flex items-center gap-2 self-end md:self-center shrink-0 flex-wrap">
              {(b.status === 'borrowed' || b.status === 'overdue') && (
                <form method="POST" action={`/api/borrowings/${b.id}/request-return`}>
                  <button
                    type="submit"
                    class="px-4 py-2.5 rounded-2xl bg-indigo-brand hover:bg-indigo-hover text-white text-xs font-bold transition flex items-center gap-1.5 shadow-md shadow-indigo-500/20 cursor-pointer"
                  >
                    <span>Ajukan Pengembalian</span>
                  </button>
                </form>
              )}
              <a
                href={`/riwayat/${b.borrowingCode}`}
                class={`px-4 py-2.5 rounded-2xl text-xs font-bold border transition flex items-center gap-1.5 shadow-2xs ${
                  b.status === 'return_pending'
                    ? 'bg-amber-500 hover:bg-amber-600 text-white border-amber-500'
                    : 'bg-rose-50 hover:bg-rose-100 text-primary border-rose-200'
                }`}
              >
                <span>{b.status === 'return_pending' ? 'Tunjukkan QR Pengembalian' : 'Lihat QR Bukti'}</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</StudentLayout>
