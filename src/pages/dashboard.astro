---
import StudentLayout from '../components/layout/StudentLayout.astro';
import { getCurrentUser } from '../lib/auth';
import { db, schema } from '../db';
import { eq, desc } from 'drizzle-orm';
import { StatusBadge } from '../components/borrowing/StatusBadge';
import { CountdownBadge } from '../components/borrowing/CountdownBadge';
import { Mascot } from '../components/illustrations/Mascot';
import { CategoryIcon } from '../components/illustrations/CategoryIcon';
import { formatRupiah } from '../lib/format-rupiah';
import { calculateFine } from '../lib/fine';

const user = await getCurrentUser(Astro.cookies);
if (!user) return Astro.redirect('/login');

// Fetch user borrowings
const userBorrowings = await db
  .select({
    borrowing: schema.borrowings,
    item: schema.items,
  })
  .from(schema.borrowings)
  .innerJoin(schema.items, eq(schema.borrowings.itemId, schema.items.id))
  .where(eq(schema.borrowings.userId, user.id))
  .orderBy(desc(schema.borrowings.createdAt))
  .all();

// Compute dynamic fine and stats
let activeCount = 0;
let pendingCount = 0;
let returnedCount = 0;
let totalFineUnpaid = 0;

const processedBorrowings = userBorrowings.map(({ borrowing, item }) => {
  let status = borrowing.status;
  let fine = borrowing.fineAmount;

  if (status === 'borrowed') {
    const calc = calculateFine(borrowing.dueDate);
    if (calc.isOverdue) {
      status = 'overdue';
      fine = Math.max(fine, calc.fineAmount);
    }
  }

  if (status === 'borrowed' || status === 'overdue') activeCount++;
  else if (status === 'pending') pendingCount++;
  else if (status === 'returned') returnedCount++;

  if (fine > 0 && !borrowing.finePaidAt) {
    totalFineUnpaid += fine;
  }

  return {
    ...borrowing,
    status,
    fineAmount: fine,
    item,
  };
});

const activeBorrowings = processedBorrowings.filter(
  (b) => b.status === 'borrowed' || b.status === 'overdue' || b.status === 'pending'
);
---

<StudentLayout title="Beranda Mahasiswa" activeNav="dashboard">
  <div class="space-y-6">
    {/* Welcome Hero Banner with Authentication Aesthetic */}
    <div data-animate="fade-up" class="relative bg-[#1E1B3A] rounded-3xl p-6 md:p-9 text-white shadow-xl overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6 border border-gray-100">
      {/* Background Bookshelf Accents with Soft Gradient */}
      <div class="absolute inset-0 z-0 opacity-20 pointer-events-none overflow-hidden">
        <img
          src="/images/bookshelf-bg.jpg"
          alt="Bookshelf"
          class="w-full h-full object-cover object-center filter blur-xs"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#1E1B3A] via-[#1E1B3A]/90 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-lg space-y-3 text-center md:text-left">
        <div class="inline-flex items-center gap-2 bg-amber-500/20 text-amber-300 border border-amber-400/30 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider backdrop-blur-sm">
          <span>Halo, {user.name.split(' ')[0]}!</span>
        </div>
        <div>
          <h1 class="text-2xl md:text-3xl font-extrabold font-display leading-tight tracking-tight">
            Peminjaman Alat & Buku Mandiri
          </h1>
          <div class="w-11 h-1 bg-[#FF6B6B] rounded-full mt-2 mx-auto md:mx-0"></div>
        </div>
        <p class="text-xs md:text-sm text-gray-300 leading-relaxed font-normal pt-1">
          Pindai barcode pada buku atau peralatan inventaris kampus, dapatkan tiket QR digital secara instan, dan tunjukkan ke petugas saat verifikasi.
        </p>

        <div class="pt-3 flex flex-wrap gap-3 justify-center md:justify-start">
          <a
            href="/pinjam"
            class="btn-coral px-6 py-3 rounded-full text-xs font-bold tracking-wide flex items-center gap-2 cursor-pointer"
          >
            <span>Mulai Pinjam Mandiri</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/katalog"
            class="px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition backdrop-blur-sm border border-white/15"
          >
            Jelajahi Katalog
          </a>
        </div>
      </div>

      <div class="relative z-10 shrink-0 flex items-center justify-center">
        <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-3xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center p-3 shadow-2xl">
          <Mascot mood="happy" size={110} />
        </div>
      </div>
    </div>

    {/* Metrics Summary */}
    <div data-animate="stagger-list" class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-[0_10px_35px_rgba(30,27,58,0.06)] flex items-center gap-3.5 hover:shadow-md transition">
        <div class="w-12 h-12 rounded-2xl bg-rose-50 text-[#FF6B6B] flex items-center justify-center font-bold text-xl">
          {activeCount}
        </div>
        <div>
          <span class="text-[11px] font-bold text-gray-500 uppercase tracking-wider block">Dipinjam</span>
          <span class="text-base font-extrabold text-[#1E1B3A]">
            {activeCount} Barang
          </span>
        </div>
      </div>

      <div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-[0_10px_35px_rgba(30,27,58,0.06)] flex items-center gap-3.5 hover:shadow-md transition">
        <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-xl">
          {pendingCount}
        </div>
        <div>
          <span class="text-[11px] font-bold text-gray-500 uppercase tracking-wider block">Menunggu ACC</span>
          <span class="text-base font-extrabold text-[#1E1B3A]">
            {pendingCount} Pengajuan
          </span>
        </div>
      </div>

      <div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-[0_10px_35px_rgba(30,27,58,0.06)] flex items-center gap-3.5 hover:shadow-md transition">
        <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold text-xl">
          {totalFineUnpaid > 0 ? '⚠️' : '0'}
        </div>
        <div>
          <span class="text-[11px] font-bold text-gray-500 uppercase tracking-wider block">Denda Tertunda</span>
          <span class="text-sm font-extrabold text-[#1E1B3A]">
            {totalFineUnpaid > 0 ? formatRupiah(totalFineUnpaid) : 'Rp 0 (Aman)'}
          </span>
        </div>
      </div>

      <div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-[0_10px_35px_rgba(30,27,58,0.06)] flex items-center gap-3.5 hover:shadow-md transition">
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-xl">
          {returnedCount}
        </div>
        <div>
          <span class="text-[11px] font-bold text-gray-500 uppercase tracking-wider block">Selesai Kembali</span>
          <span class="text-base font-extrabold text-[#1E1B3A]">
            {returnedCount} Transaksi
          </span>
        </div>
      </div>
    </div>

    {/* Active Borrowings Section */}
    <div data-animate="fade-up" class="bg-white rounded-3xl p-6 border border-gray-100 shadow-[0_10px_35px_rgba(30,27,58,0.06)] space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-bold font-display text-[#1E1B3A]">Peminjaman Aktif & Berjalan</h2>
          <div class="w-8 h-1 bg-[#FF6B6B] rounded-full mt-1"></div>
          <p class="text-xs text-gray-500 mt-1">Barang yang sedang Anda bawa atau menunggu persetujuan petugas</p>
        </div>
        <a href="/riwayat" class="text-xs font-bold text-[#FF6B6B] hover:underline">
          Lihat Semua →
        </a>
      </div>

      {activeBorrowings.length === 0 ? (
        <div class="py-10 text-center space-y-3">
          <div class="w-16 h-16 rounded-full bg-rose-50 text-[#FF6B6B] flex items-center justify-center mx-auto">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="font-bold text-sm text-[#1E1B3A]">Tidak ada peminjaman aktif</h3>
          <p class="text-xs text-gray-500 max-w-sm mx-auto">
            Anda belum meminjam barang inventaris kampus saat ini. Silakan scan barcode atau lihat katalog untuk mulai meminjam.
          </p>
          <a
            href="/pinjam"
            class="btn-coral inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-bold cursor-pointer"
          >
            Pinjam Barang Sekarang
          </a>
        </div>
      ) : (
        <div data-animate="stagger-list" class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          {activeBorrowings.map((b) => (
            <div class="p-5 rounded-2xl border border-gray-100 hover:border-rose-200 bg-[#FBFBFF] transition flex flex-col justify-between space-y-3.5 shadow-2xs hover:shadow-sm">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-white border border-gray-200 text-[#1E1B3A] flex items-center justify-center shadow-xs">
                    <CategoryIcon category={b.item.category} size={20} />
                  </div>
                  <div>
                    <span class="text-[10px] font-mono font-bold text-gray-500 bg-gray-100 px-2 py-0.5 rounded">
                      {b.item.itemCode}
                    </span>
                    <h4 class="font-bold text-sm text-[#1E1B3A] line-clamp-1 mt-0.5" title={b.item.name}>
                      {b.item.name}
                    </h4>
                  </div>
                </div>
                <StatusBadge status={b.status} size="sm" />
              </div>

              <div class="flex items-center justify-between text-xs pt-2.5 border-t border-gray-100">
                <CountdownBadge dueDate={b.dueDate} status={b.status} />
                <a
                  href={`/riwayat/${b.borrowingCode}`}
                  class="font-bold text-xs text-[#FF6B6B] hover:bg-rose-50 flex items-center gap-1 bg-white px-3 py-1.5 rounded-xl border border-rose-200 shadow-2xs transition"
                >
                  <span>QR Bukti</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</StudentLayout>
